{
  "manifest_version": 3,
  "name": "X Clean Feed v2",
  "version": "2.0",
  "description": "Clean X.com: hide sidebar + force Following feed",
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
