{
  "manifest_version": 3,
  "name": "X Clean Feed v3",
  "version": "3.1",
  "description": "Clean X: hide sidebar + force Following feed",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
